%%%% case 2 (railroad.md:61)
railroad-ebnf-beta
letter = "a" | "b" | "c" ;
identifier = letter ;
%%%% case 3 (railroad.md:80)
railroad-ebnf-beta
greeting = "Hello" " " "World" ;
%%%% case 4 (railroad.md:94)
