<Law Lang="ja" Era="Heisei" Year="27" Num="010" PromulgateMonth="03" PromulgateDay="20" LawType="MinisterialOrdinance">
  <LawNum>平成二十七年内閣府令第十号</LawNum>
  <LawBody>
    <LawTitle Kana="しょくひんひょうじきじゅん" Abbrev="" AbbrevKana="">食品表示基準</LawTitle>
    <EnactStatement>食品表示法（平成二十五年法律第七十号）第四条第一項の規定に基づき、食品表示基準を次のように定める。</EnactStatement>
    <MainProvision>
      <Article Num="1">
        <ArticleCaption>（適用範囲）</ArticleCaption>
        <ArticleTitle>第一条</ArticleTitle>
        <Paragraph Num="1">
          <ParagraphNum />
          <ParagraphSentence>
            <Sentence Function="main" Num="1" WritingMode="vertical">この府令は、食品関連事業者等が、加工食品、生鮮食品又は添加物を販売する場合について適用する。</Sentence>
            <Sentence Function="proviso" Num="2" WritingMode="vertical">ただし、加工食品又は生鮮食品を設備を設けて飲食させる場合には、第四十条の規定を除き、適用しない。</Sentence>
          </ParagraphSentence>
        </Paragraph>
      </Article>
    </MainProvision>
