{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sorane-spot-relay",
  "main": "worker/spot-entry.ts",
  "account_id": "4b749427a0c80c547e726a42aff4b6fc",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "routes": [
    { "pattern": "spot.sorane.dev", "custom_domain": true, "zone_name": "sorane.dev" }
  ],
  "assets": {
    "directory": "./www/spot",
    "binding": "ASSETS",
    "run_worker_first": ["/api/relay/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true }
  }
}
