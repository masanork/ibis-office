{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "metadata": {
    "component": {
      "type": "application",
      "name": "Demo payment service",
      "bom-ref": "payments"
    }
  },
  "components": [
    {
      "type": "library",
      "name": "Demo crypto provider",
      "bom-ref": "provider",
      "components": [
        {
          "type": "cryptographic-asset",
          "name": "RSA-2048",
          "bom-ref": "rsa",
          "cryptoProperties": {
            "assetType": "algorithm",
            "algorithmProperties": {
              "primitive": "signature",
              "parameterSetIdentifier": "2048",
              "classicalSecurityLevel": 112
            }
          }
        },
        {
          "type": "cryptographic-asset",
          "name": "ML-DSA-65",
          "bom-ref": "ml-dsa",
          "cryptoProperties": {
            "assetType": "algorithm",
            "algorithmProperties": {
              "primitive": "signature",
              "parameterSetIdentifier": "65",
              "nistQuantumSecurityLevel": 3
            }
          }
        }
      ]
    },
    {
      "type": "cryptographic-asset",
      "name": "Demo payment certificate",
      "bom-ref": "cert",
      "cryptoProperties": {
        "assetType": "certificate",
        "certificateProperties": {
          "subjectName": "CN=payments.example.test",
          "issuerName": "CN=Demo CA",
          "notValidAfter": "2028-12-31T00:00:00Z",
          "signatureAlgorithmRef": "rsa"
        }
      }
    },
    {
      "type": "cryptographic-asset",
      "name": "Demo TLS",
      "bom-ref": "tls",
      "cryptoProperties": {
        "assetType": "protocol",
        "protocolProperties": {
          "type": "tls",
          "version": "1.3"
        }
      }
    },
    {
      "type": "cryptographic-asset",
      "name": "Demo key entry",
      "bom-ref": "key",
      "cryptoProperties": {
        "assetType": "related-crypto-material",
        "relatedCryptoMaterialProperties": {
          "type": "private-key",
          "algorithmRef": "rsa",
          "value": "SYNTHETIC-MATERIAL-VALUE-NOT-EXPORTED"
        }
      }
    }
  ],
  "dependencies": [
    {
      "ref": "payments",
      "dependsOn": [
        "tls",
        "cert"
      ]
    },
    {
      "ref": "provider",
      "provides": [
        "rsa",
        "ml-dsa"
      ]
    },
    {
      "ref": "cert",
      "dependsOn": [
        "rsa"
      ]
    }
  ]
}
