+// The bar and Dock menu can be replaced independently. Never reuse a tag from
+// a retired menu, since AppKit may still be tracking one of its items.
+#[derive(Default)]
+struct MenuActions {
+    first_tag: usize,
+    actions: Vec<Option<Box<dyn Action>>>,
+}
+
+impl MenuActions {
+    fn push(&mut self, action: Option<Box<dyn Action>>) -> NSInteger {
+        let tag = self.end_tag();
+        self.actions.push(action);
+        tag as NSInteger
+    }
+
+    fn end_tag(&self) -> usize {
+        self.first_tag + self.actions.len()
+    }
+
+    fn get(&self, tag: usize) -> Option<&dyn Action> {
+        self.actions.get(tag.checked_sub(self.first_tag)?)?.as_deref()
+    }
+}
+
