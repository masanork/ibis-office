{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ibisOffice DOCX AI edit proposal, version 1",
  "description": "Input to ai-preview and ai-apply. The CLI checks source identity, citation ranges, formatting boundaries and conflicts against the original document.",
  "oneOf": [
    {
      "$ref": "#/$defs/edit",
      "required": ["version", "sourceSha256"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sourceSha256", "edits"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "sourceSha256": { "$ref": "#/$defs/sourceSha256" },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/edit" }
        }
      }
    }
  ],
  "$defs": {
    "version": { "const": 1 },
    "sourceSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "not": { "pattern": "[^0-9a-f]" }
    },
    "byteRange": {
      "description": "Zero-based UTF-8 byte range. Start is inclusive and end is exclusive. The CLI checks ordering and UTF-8 boundaries.",
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markdownBytes", "quote", "before", "replacement"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "sourceSha256": {
          "$ref": "#/$defs/sourceSha256",
          "description": "Optional inside a batch. When supplied, it must match the batch hash."
        },
        "target": {
          "const": "tableCell",
          "description": "Omit to edit a body paragraph."
        },
        "markdownBytes": { "$ref": "#/$defs/byteRange" },
        "paragraphBytes": { "$ref": "#/$defs/byteRange" },
        "quote": { "type": "string", "minLength": 1 },
        "before": { "type": "string" },
        "replacement": {
          "type": "string",
          "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]" }
        },
        "insert": { "enum": ["before", "after"] }
      },
      "dependentRequired": { "insert": ["paragraphBytes"] },
      "allOf": [
        {
          "if": { "properties": { "replacement": { "const": "" } } },
          "then": {
            "required": ["paragraphBytes"],
            "not": { "required": ["insert"] }
          }
        }
      ]
    }
  }
}
