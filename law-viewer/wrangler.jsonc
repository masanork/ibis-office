{
  "name": "sorane-law-viewer",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "routes": [
    { "pattern": "law.sorane.dev", "custom_domain": true, "zone_name": "sorane.dev" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
